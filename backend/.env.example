# Copy this file to backend/.env and fill in your values. Never commit .env.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# If you get a model or quota error, try another model from the Gemini docs, e.g. gemini-3.6-flash
GEMINI_MODEL=gemini-3.8-flash
# Optional: models to try, in order, if the main one is overloaded (503) or out of quota. JSON list.
# GEMINI_FALLBACK_MODELS=["gemini-3.6-flash"]

# Optional local fallback model via Ollama (https://ollama.com). Install Ollama, run `ollama pull qwen2.5:3b`,
# then uncomment. Used only if every Gemini model fails; with no GEMINI_API_KEY it becomes the only model.
# OLLAMA_MODEL=qwen2.5:3b
# Local dev only; docker compose points this at host.docker.internal automatically.
# OLLAMA_BASE_URL=http://localhost:11434

# Speed: turn off "thinking" for short factual answers (much lower latency), fewer retries, shorter timeout
# GEMINI_THINKING_BUDGET=0
# LLM_MAX_RETRIES=1
# LLM_TIMEOUT=20

# Local development (docker compose maps Postgres to localhost:5433)
DATABASE_URL=postgresql+psycopg://documind:documind@localhost:5433/documind

# Optional tuning
# CHUNK_SIZE=600
# CHUNK_OVERLAP=100
# TOP_K=5
# USE_RERANKER=true
